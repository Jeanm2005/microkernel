# Used by `selftest=app-crash`: same as system.manifest, plus an
# application that tries to write to the serial port itself (arg 1 =
# HELLO_CRASH). It holds no I/O ports, so the CPU refuses and the kernel
# kills it; the console and the other application must not notice.
#
# name      image         priority  provides  uses      devices  arg
console     console.elf   200       console   -         com1     0
crasher     hello.elf     100       -         console   -        1
hello       hello.elf     100       -         console   -        0
